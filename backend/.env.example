# Copie este arquivo para .env e preencha com valores reais.
# NUNCA cometa o arquivo .env no git (já está no .gitignore).

# Banco de dados (Render/Railway fornecem essa string pronta)
DATABASE_URL=postgres://usuario:senha@host:5432/dashboard_meta_ads

# Meta / Facebook
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXX
META_API_VERSION=v21.0

# Servidor
PORT=3001

# Segurança do login da equipe (gere uma string aleatória longa)
SESSION_SECRET=
